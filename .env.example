# =============================================================================
# AIZIX — copy to .env.local (web) and .env (api) as needed
# =============================================================================

# --- Frontend (apps/web) — prefix NEXT_PUBLIC_ for browser ---
NEXT_PUBLIC_APP_NAME=AIZIX
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Supabase (client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Backend (apps/api) ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase (server — never expose service role to the browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Database (optional until wired)
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Trading mode (paper only for now)
TRADING_MODE=paper
