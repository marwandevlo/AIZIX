# --- AIZIX SaaS (FastAPI + SQLAlchemy + JWT) ---

# --- Production quick reference (Render / Railway) ---
# Set these in the platform dashboard; do not commit real secrets.
PAPER_TRADING=true
LIVE_TRADING_ENABLED=false
DATABASE_URL=
# Prefer JWT_SECRET_KEY in production; SECRET_KEY is accepted as an alias (see app/core/config.py).
SECRET_KEY=
BINANCE_PUBLIC_DATA=true

# Server
HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8001,http://127.0.0.1:8001

# Database (pick one)
# SQLite (dev):
# DATABASE_URL=sqlite:///./aizix.db
# Local PostgreSQL (e.g. docker compose in this folder):
DATABASE_URL=postgresql+psycopg://aizix:aizix@127.0.0.1:5432/aizix
# Supabase: use the "Connection string" (URI) from project settings, often port 5432 or 6543 (pooler):
# DATABASE_URL=postgresql+psycopg://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Auth (required for multi-tenant API)
REQUIRE_AUTH=true
JWT_SECRET_KEY=replace-with-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Demo account (seeded on startup for local login when using auth)
DEMO_USER_EMAIL=demo@aizix.local
DEMO_USER_PASSWORD=demo1234

# Paper trading
PAPER_TRADING=true

# Risk envelope (%)
MAX_DAILY_LOSS=5
MAX_RISK_PER_TRADE=2
MAX_OPEN_TRADES=6
MIN_SIGNAL_CONFIDENCE=55

# Optional: legacy Supabase client (not required when using DATABASE_URL only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Market data
USE_BINANCE_MARKET=true
BINANCE_BASE_URL=https://api.binance.com

# Signal UX (deterministic midpoint between min/max is used for delay)
SIGNAL_LATENCY_MS_MIN=80
SIGNAL_LATENCY_MS_MAX=280
