# --- AIZIX SaaS (FastAPI + SQLAlchemy + JWT) ---

# --- Render / quick smoke (copy into dashboard) ---
# WARNING: Never set DEMO_USER_PASSWORD to the same value as SECRET_KEY/JWT_SECRET_KEY if that value is long.
# bcrypt hashes user passwords only — JWT secrets may be long; demo seed uses fixed "AizixDemo123!" in code.
PAPER_TRADING=true
LIVE_TRADING_ENABLED=false
BINANCE_PUBLIC_DATA=true
DATABASE_URL=sqlite:////tmp/aizix.db
SECRET_KEY=aizix-secret-2026
JWT_SECRET_KEY=aizix-secret-2026
DEMO_USER_PASSWORD=AizixDemo123!

# Server
HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8001,http://127.0.0.1:8001

# Auth (multi-tenant API)
REQUIRE_AUTH=true
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Demo account email (password hash on disk always seeded from DEMO_SEED_PASSWORD in app/db/bootstrap.py)
DEMO_USER_EMAIL=demo@aizix.local

# --- Local dev: PostgreSQL example (optional; swap DATABASE_URL above) ---
# DATABASE_URL=postgresql+psycopg://aizix:aizix@127.0.0.1:5432/aizix
# Supabase:
# DATABASE_URL=postgresql+psycopg://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Risk envelope (%)
MAX_DAILY_LOSS=5
MAX_RISK_PER_TRADE=2
MAX_OPEN_TRADES=6
MIN_SIGNAL_CONFIDENCE=55

# Optional: legacy Supabase client (not required when using DATABASE_URL only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Market data
USE_BINANCE_MARKET=true
BINANCE_BASE_URL=https://api.binance.com

# Signal UX
SIGNAL_LATENCY_MS_MIN=80
SIGNAL_LATENCY_MS_MAX=280
